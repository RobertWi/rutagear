<?xml version="1.0" encoding="utf-8"?>
<!-- Stylised cassette / chainring: outer dark green ring with eight
     teeth + inner gear hub. Sticks to the Ruta family palette
     (#1B5E20 / #2E7D32 / #66BB6A) used by rutatail and rutaradar. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Outer toothed gear ring. Eight rectangular teeth at 45° spacing
         around a 18-radius circle. Path drawn as one filled polygon for
         simplicity (vector drawables don't support repeat-rotate). -->
    <path
        android:fillColor="#1B5E20"
        android:pathData="M24,2
            L27,2 L27,8 L33,9 L36,4 L39,7 L36,12 L40,16 L46,15 L46,18
            L40,21 L42,26 L46,30 L44,33 L38,32 L34,38 L37,42 L34,45
            L29,40 L23,42 L21,46 L18,46 L17,40 L11,38 L7,41 L4,38
            L9,34 L6,28 L2,27 L2,24 L8,23 L9,17 L4,13 L7,10 L13,15
            L19,12 L22,7 L24,2 Z" />

    <!-- Middle annulus: dark-on-dark spokes implied by the inner cut-out.
         Lighter green to give the ring a subtle bevel. -->
    <path
        android:fillColor="#2E7D32"
        android:pathData="M24,10 m-12,0 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 Z
                          M24,16 m-7,0 a7,7 0 1,1 14,0 a7,7 0 1,1 -14,0 Z" />

    <!-- Hub bolt circle in the brightest accent. -->
    <path
        android:fillColor="#66BB6A"
        android:pathData="M24,22 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z" />
</vector>
