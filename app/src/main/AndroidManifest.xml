<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Audio: tweak the music stream volume + duck other audio while
         our shift sounds play. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Custom-MP3 picker uses the Storage Access Framework
         (ACTION_OPEN_DOCUMENT) which grants per-Uri read permission, so
         no READ_EXTERNAL_STORAGE is strictly required. We declare it
         with maxSdkVersion=28 only as a fallback for very old Karoo
         firmwares (pre-API 29 scoped storage). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- The extension service runs while a ride is recording so the OS
         can't kill it during a long climb. Shifting telemetry counts as
         a connectedDevice (the cassette/derailleur sensor). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_gear"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RutagearExtension"
            android:exported="true"
            android:foregroundServiceType="connectedDevice"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>
    </application>
</manifest>
